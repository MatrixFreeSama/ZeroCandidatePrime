}

// Bounded experimental chain. q/count survive between host launches. Each
// successor step uses the same 256-lane high-dimensional projection.
.visible .entry zero_candidate_prime_explore_hd(
    .param .u64 current_p_p,
    .param .u64 current_rank_p,
    .param .u64 steps_p,
    .param .u64 qptr_p,
    .param .u64 countptr_p,
    .param .u64 flvl_p,
    .param .u64 fcur_p,
    .param .u64 ftotal_p,
    .param .u64 fwait_p,
    .param .u64 maxcount_p,
    .param .u64 out_p,
    .param .u64 statsptr_p,
    .param .u64 gaptemp_p,
    .param .u64 mtemp_p,
    .param .u64 candidate_p,
    .param .u64 hit_p)
{
    .reg .pred %p<12>;
    .reg .u32 %r<6>;
    .reg .u64 %rd<32>;
    ld.param.u64 %rd0, [current_p_p];
    ld.param.u64 %rd1, [current_rank_p];
    ld.param.u64 %rd2, [steps_p];
    ld.param.u64 %rd3, [qptr_p];
    ld.param.u64 %rd4, [countptr_p];
    ld.param.u64 %rd5, [flvl_p];
    ld.param.u64 %rd6, [fcur_p];
    ld.param.u64 %rd7, [ftotal_p];
    ld.param.u64 %rd8, [fwait_p];
    ld.param.u64 %rd9, [maxcount_p];
    ld.param.u64 %rd10, [out_p];
    ld.param.u64 %rd11, [statsptr_p];
    ld.param.u64 %rd12, [gaptemp_p];
    ld.param.u64 %rd13, [mtemp_p];
    ld.param.u64 %rd14, [candidate_p];
    ld.param.u64 %rd15, [hit_p];
    mov.u32 %r0, %tid.x;

    setp.ne.u32 %p0, %r0, 0;
    @%p0 bra ZEX_init_wait;
    st.global.u64 [%rd10+0], 0;
    st.global.u64 [%rd10+8], %rd0;
    st.global.u64 [%rd10+16], %rd1;
    st.global.u64 [%rd10+24], 0;
    st.global.u64 [%rd10+32], 0;
ZEX_init_wait:
    bar.sync 0;
    mov.u64 %rd16, 0;
    mov.u64 %rd17, 0;
ZEX_loop:
    setp.ge.u64 %p1, %rd16, %rd2;
    @%p1 bra ZEX_success;
    add.u64 %rd18, %rd10, 24;
    call.uni (%r1), hd_next_gap_block, (%rd0, %rd3, %rd4, %rd5, %rd6, %rd7, %rd8,
        %rd9, %rd12, %rd13, %rd14, %rd15, %rd18, %rd11);
    setp.eq.u32 %p2, %r1, 0;
    @%p2 bra ZEX_limit;
    ld.global.u64 %rd17, [%rd18];
    ld.global.u64 %rd0, [%rd14];
    add.u64 %rd1, %rd1, 1;
    setp.eq.u64 %p3, %rd1, 0;
    @%p3 bra ZEX_limit;
    add.u64 %rd16, %rd16, 1;
    bra ZEX_loop;
ZEX_success:
    setp.ne.u32 %p4, %r0, 0;
    @%p4 ret;
    st.global.u64 [%rd10+0], 1;
    st.global.u64 [%rd10+8], %rd0;
    st.global.u64 [%rd10+16], %rd1;
    st.global.u64 [%rd10+24], %rd17;
    st.global.u64 [%rd10+32], %rd16;
    ret;
ZEX_limit:
    setp.ne.u32 %p5, %r0, 0;
    @%p5 ret;
    st.global.u64 [%rd10+0], 3;
    st.global.u64 [%rd10+8], %rd0;
    st.global.u64 [%rd10+16], %rd1;
    st.global.u64 [%rd10+24], %rd17;
    st.global.u64 [%rd10+32], %rd16;
    ret;
}


// ---------------------------------------------------------------------------
// 128-bit record-seeded implicit-dimension GPU path.
// No persistent prime basis is accepted as input. q[0..depth-1] below is only
// a fixed-size live recursion workspace rebuilt from q0=2 for each successor.
// All 256 lanes project the current 128-bit survivor across the live dimensions.
// ---------------------------------------------------------------------------

.func (.reg .u64 rv) ir_u128_mod(
    .reg .u64 hi, .reg .u64 lo, .reg .u64 q)
{
    .reg .pred %p<8>;
    .reg .u32 %r<4>;
    .reg .u64 %rd<12>;
    setp.eq.u64 %p0, q, 0;
    @%p0 bra IRM_ZERO;
    rem.u64 %rd0, hi, q;
    mov.u32 %r0, 0;
IRM_LOOP:
    setp.ge.u32 %p1, %r0, 64;
    @%p1 bra IRM_DONE;
    and.b64 %rd1, lo, 0x8000000000000000;
    setp.ne.u64 %p2, %rd1, 0;
    selp.u64 %rd2, 1, 0, %p2;
    shl.b64 lo, lo, 1;
    sub.u64 %rd3, q, %rd0;
    setp.ge.u64 %p3, %rd0, %rd3;
    @%p3 bra IRM_SUBPATH;
    add.u64 %rd0, %rd0, %rd0;
    add.u64 %rd0, %rd0, %rd2;
    bra IRM_NORM;
IRM_SUBPATH:
    sub.u64 %rd0, %rd0, %rd3;
    add.u64 %rd0, %rd0, %rd2;
IRM_NORM:
    setp.ge.u64 %p4, %rd0, q;
    @%p4 sub.u64 %rd0, %rd0, q;
    add.u32 %r0, %r0, 1;
    bra IRM_LOOP;
IRM_DONE:
    mov.u64 rv, %rd0;
    ret;
IRM_ZERO:
    mov.u64 rv, 0;
    ret;
}

.func (.reg .u32 rv) ir_M128(
    .reg .u64 qptr, .reg .u64 count,
    .reg .u64 flvl, .reg .u64 flo, .reg .u64 fhi,
    .reg .u64 ftotal, .reg .u64 fwait,
    .reg .u64 level, .reg .u64 xlo, .reg .u64 xhi,
    .reg .u64 maxcount, .reg .u64 outptr, .reg .u64 statsptr)
{
    .reg .pred %p<20>;
    .reg .u32 %r<8>;
    .reg .u64 %rd<40>;
    setp.ge.u64 %p0, level, count;
    @%p0 bra IR128_FAIL;
    setp.ge.u64 %p1, level, maxcount;
    @%p1 bra IR128_FAIL;
    mov.u64 %rd0, 1; // depth
    mov.u64 %rd1, 0; // return distance
    st.global.u64 [flvl], level;
    st.global.u64 [flo], xlo;
    st.global.u64 [fhi], xhi;
    st.global.u64 [ftotal], 0;
    st.global.u64 [fwait], 0;
IR128_LOOP:
    setp.eq.u64 %p2, %rd0, 0;
    @%p2 bra IR128_DONE;
    sub.u64 %rd2, %rd0, 1;
    shl.b64 %rd3, %rd2, 3;
    add.u64 %rd4, flvl, %rd3;
    add.u64 %rd5, flo, %rd3;
    add.u64 %rd6, fhi, %rd3;
    add.u64 %rd7, ftotal, %rd3;
    add.u64 %rd8, fwait, %rd3;
    ld.global.u64 %rd9, [%rd4];
    setp.eq.u64 %p3, %rd9, 0;
    @%p3 bra IR128_BASE;
    ld.global.u64 %rd10, [%rd8];
    setp.eq.u64 %p4, %rd10, 0;
    @%p4 bra IR128_DESCEND;
    ld.global.u64 %rd11, [%rd7];
    add.u64 %rd12, %rd11, %rd1;
    setp.lt.u64 %p5, %rd12, %rd11;
    @%p5 bra IR128_FAIL;
    ld.global.u64 %rd13, [%rd5];
    ld.global.u64 %rd14, [%rd6];
    add.cc.u64 %rd15, %rd13, %rd1;
    addc.u64 %rd16, %rd14, 0;
    setp.lt.u64 %p6, %rd16, %rd14;
    @%p6 bra IR128_FAIL;
    st.global.u64 [%rd7], %rd12;
    st.global.u64 [%rd5], %rd15;
    st.global.u64 [%rd6], %rd16;
    ld.global.u64 %rd17, [statsptr+24];add.u64 %rd17,%rd17,1;st.global.u64 [statsptr+24],%rd17;
    ld.global.u64 %rd18, [statsptr+32];add.u64 %rd18,%rd18,1;st.global.u64 [statsptr+32],%rd18;
    shl.b64 %rd19, %rd9, 3;add.u64 %rd20, qptr, %rd19;ld.global.u64 %rd21, [%rd20];
    call.uni (%rd22), ir_u128_mod, (%rd16, %rd15, %rd21);
    setp.ne.u64 %p7, %rd22, 0;
    @%p7 bra IR128_RETURN;
    st.global.u64 [%rd8], 0;
    bra IR128_LOOP;
IR128_RETURN:
    mov.u64 %rd1, %rd12;
    sub.u64 %rd0, %rd0, 1;
    bra IR128_LOOP;
IR128_DESCEND:
    st.global.u64 [%rd8], 1;
    setp.ge.u64 %p8, %rd0, maxcount;
    @%p8 bra IR128_FAIL;
    shl.b64 %rd23, %rd0, 3;
    add.u64 %rd24, flvl, %rd23;add.u64 %rd25, flo, %rd23;add.u64 %rd26, fhi, %rd23;
    add.u64 %rd27, ftotal, %rd23;add.u64 %rd28, fwait, %rd23;
    sub.u64 %rd29, %rd9, 1;
    st.global.u64 [%rd24], %rd29;
    ld.global.u64 %rd30, [%rd5];ld.global.u64 %rd31, [%rd6];
    st.global.u64 [%rd25], %rd30;st.global.u64 [%rd26], %rd31;
    st.global.u64 [%rd27], 0;st.global.u64 [%rd28], 0;
    add.u64 %rd0, %rd0, 1;
    bra IR128_LOOP;
IR128_BASE:
    // Uniform q0 survivor rule for 128-bit state. No parity/odd shortcut.
    ld.global.u64 %rd32, [%rd5];
    ld.global.u64 %rd33, [%rd6];
    ld.global.u64 %rd35, [qptr];
    mov.u64 %rd34, 0;
IR128_BASE_LOOP:
    mov.u64 %rd37, %rd33;
    add.cc.u64 %rd32, %rd32, 1;
    addc.u64 %rd33, %rd33, 0;
    setp.lt.u64 %p9, %rd33, %rd37;
    @%p9 bra IR128_FAIL;
    add.u64 %rd34, %rd34, 1;
    ld.global.u64 %rd38,[statsptr+32];add.u64 %rd38,%rd38,1;st.global.u64 [statsptr+32],%rd38;
    call.uni (%rd36), ir_u128_mod, (%rd33, %rd32, %rd35);
    setp.ne.u64 %p10, %rd36, 0;
    @%p10 bra IR128_BASE_DONE;
    ld.global.u64 %rd38,[statsptr+24];add.u64 %rd38,%rd38,1;st.global.u64 [statsptr+24],%rd38;
    bra IR128_BASE_LOOP;
IR128_BASE_DONE:
    mov.u64 %rd1, %rd34;
    sub.u64 %rd0, %rd0, 1;
    bra IR128_LOOP;
IR128_DONE:
    st.global.u64 [outptr], %rd1;
    mov.u32 rv, 1;
    ret;
IR128_FAIL:
    mov.u32 rv, 0;
    ret;
}

.visible .entry zero_candidate_prime_record_implicit(
    .param .u64 rank_lo_p,
    .param .u64 rank_hi_p,
    .param .u64 p_lo_p,
    .param .u64 p_hi_p,
    .param .u64 steps_p,
    .param .u64 depth_p,
    .param .u64 qptr_p,
    .param .u64 countptr_p,
    .param .u64 flvl_p,
    .param .u64 fcur_p,
    .param .u64 ftotal_p,
    .param .u64 fwait_p,
    .param .u64 wflvl_p,
    .param .u64 wlo_p,
    .param .u64 whi_p,
    .param .u64 wtotal_p,
    .param .u64 wwait_p,
    .param .u64 out_p,
    .param .u64 statsptr_p,
    .param .u64 gaptemp_p,
    .param .u64 mtemp_p,
    .param .u64 candlo_p,
    .param .u64 candhi_p,
    .param .u64 hit_p,
    .param .u64 minlevel_p)
{
    .reg .pred %p<32>;
    .reg .u32 %r<24>;
    .reg .u64 %rd<64>;
    ld.param.u64 %rd0,[rank_lo_p];ld.param.u64 %rd1,[rank_hi_p];
    ld.param.u64 %rd2,[p_lo_p];ld.param.u64 %rd3,[p_hi_p];
    ld.param.u64 %rd4,[steps_p];ld.param.u64 %rd5,[depth_p];
    ld.param.u64 %rd6,[qptr_p];ld.param.u64 %rd7,[countptr_p];
    ld.param.u64 %rd8,[flvl_p];ld.param.u64 %rd9,[fcur_p];ld.param.u64 %rd10,[ftotal_p];ld.param.u64 %rd11,[fwait_p];
    ld.param.u64 %rd12,[wflvl_p];ld.param.u64 %rd13,[wlo_p];ld.param.u64 %rd14,[whi_p];ld.param.u64 %rd15,[wtotal_p];ld.param.u64 %rd16,[wwait_p];
    ld.param.u64 %rd17,[out_p];ld.param.u64 %rd18,[statsptr_p];ld.param.u64 %rd19,[gaptemp_p];ld.param.u64 %rd20,[mtemp_p];
    ld.param.u64 %rd21,[candlo_p];ld.param.u64 %rd22,[candhi_p];ld.param.u64 %rd23,[hit_p];ld.param.u64 %rd24,[minlevel_p];
    mov.u32 %r0,%tid.x;
    setp.lt.u64 %p0,%rd5,4;@%p0 bra RIR_BAD;
    setp.gt.u64 %p1,%rd5,256;@%p1 bra RIR_BAD;
    setp.ne.u32 %p2,%r0,0;@%p2 bra RIR_INIT_WAIT;
    st.global.u64 [%rd17+0],0;st.global.u64 [%rd17+8],%rd0;st.global.u64 [%rd17+16],%rd1;
    st.global.u64 [%rd17+24],%rd2;st.global.u64 [%rd17+32],%rd3;st.global.u64 [%rd17+40],0;st.global.u64 [%rd17+48],0;st.global.u64 [%rd17+56],0;
    st.global.u64 [%rd18+0],0;st.global.u64 [%rd18+8],0;st.global.u64 [%rd18+16],0;st.global.u64 [%rd18+24],0;st.global.u64 [%rd18+32],0;
    st.global.u32 [%rd23],0;
RIR_INIT_WAIT:
    bar.sync 0;
    mov.u64 %rd25,0; // completed steps
RIR_STEP_LOOP:
    setp.ge.u64 %p3,%rd25,%rd4;@%p3 bra RIR_SUCCESS;
    // Rebuild the live implicit dimension workspace for this successor only.
    setp.ne.u32 %p4,%r0,0;@%p4 bra RIR_DIM_WAIT;
    st.global.u64 [%rd6],2;st.global.u64 [%rd7],1;st.global.u32 [%rd23],0;
    mov.u64 %rd26,1;
RIR_DIM_LOOP:
    setp.ge.u64 %p5,%rd26,%rd5;@%p5 bra RIR_DIM_DONE;
    call.uni (%r1), ensure_dimension, (%rd26,%rd6,%rd7,%rd8,%rd9,%rd10,%rd11,%rd5,%rd19,%rd20,%rd18);
    setp.eq.u32 %p6,%r1,0;@%p6 bra RIR_DIM_FAIL;
    add.u64 %rd26,%rd26,1;bra RIR_DIM_LOOP;
RIR_DIM_DONE:
    ld.global.u64 %rd27,[%rd18+8];setp.ge.u64 %p7,%rd27,%rd5;@%p7 bra RIR_DIM_PEAK_OK;st.global.u64 [%rd18+8],%rd5;
RIR_DIM_PEAK_OK:
    // candidate = p + M_0(p), with q0=2 evaluated by the normal implicit rule.
    ld.global.u64 %rd27,[%rd7];
    mov.u64 %rd28,0;
    call.uni (%r12), ir_M128, (%rd6,%rd27,%rd12,%rd13,%rd14,%rd15,%rd16,%rd28,%rd2,%rd3,%rd5,%rd20,%rd18);
    setp.eq.u32 %p8,%r12,0;@%p8 bra RIR_DIM_FAIL;
    ld.global.u64 %rd28,[%rd20];
    add.cc.u64 %rd29,%rd2,%rd28;addc.u64 %rd30,%rd3,0;
    setp.lt.u64 %p8,%rd30,%rd3;@%p8 bra RIR_DIM_FAIL;
    st.global.u64 [%rd21],%rd29;st.global.u64 [%rd22],%rd30;st.global.u64 [%rd24],1;
    bra RIR_DIM_WAIT;
RIR_DIM_FAIL:
    mov.u32 %r2,0xfffffffd;st.global.u32 [%rd23],%r2;
RIR_DIM_WAIT:
    bar.sync 0;
    ld.global.u32 %r3,[%rd23];setp.eq.u32 %p9,%r3,0xfffffffd;@%p9 bra RIR_LIMIT;

RIR_PROJECT:
