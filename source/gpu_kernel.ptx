.version 6.0
.target sm_52
.address_size 64

// Exact integer high-dimensional survivor-state recurrence.
// 256 CUDA lanes project the current survivor across prime dimensions in parallel.
// Dimension-chain growth and nested survivor jumps remain exact and causal.
// No floating point and no Tensor Core.

.func (.reg .u32 rv) own_M(
    .reg .u64 qptr, .reg .u64 count,
    .reg .u64 flvl, .reg .u64 fcur, .reg .u64 ftotal, .reg .u64 fwait,
    .reg .u64 level, .reg .u64 x, .reg .u64 maxcount,
    .reg .u64 outptr, .reg .u64 statsptr)
{
    .reg .pred %p<16>;
    .reg .u32 %r<8>;
    .reg .u64 %rd<32>;

    setp.ge.u64 %p0, level, count;
    @%p0 bra OM_fail;
    setp.ge.u64 %p1, level, maxcount;
    @%p1 bra OM_fail;

    mov.u64 %rd0, 1;          // depth
    mov.u64 %rd1, 0;          // ret
    // frame[0]
    st.global.u64 [flvl], level;
    st.global.u64 [fcur], x;
    st.global.u64 [ftotal], 0;
    st.global.u64 [fwait], 0;

OM_loop:
    setp.eq.u64 %p2, %rd0, 0;
    @%p2 bra OM_done;
    sub.u64 %rd2, %rd0, 1;   // idx
    shl.b64 %rd3, %rd2, 3;
    add.u64 %rd4, flvl, %rd3;
    add.u64 %rd5, fcur, %rd3;
    add.u64 %rd6, ftotal, %rd3;
    add.u64 %rd7, fwait, %rd3;
    ld.global.u64 %rd8, [%rd4]; // frame level
    setp.eq.u64 %p3, %rd8, 0;
    @%p3 bra OM_base;

    ld.global.u64 %rd9, [%rd7];
    setp.eq.u64 %p4, %rd9, 0;
    @%p4 bra OM_descend;

    // return from child: total += ret, cur += ret
    ld.global.u64 %rd10, [%rd6];
    add.u64 %rd11, %rd10, %rd1;
    setp.lt.u64 %p5, %rd11, %rd10;
    @%p5 bra OM_fail;
    ld.global.u64 %rd12, [%rd5];
    add.u64 %rd13, %rd12, %rd1;
    setp.lt.u64 %p6, %rd13, %rd12;
    @%p6 bra OM_fail;
    st.global.u64 [%rd6], %rd11;
    st.global.u64 [%rd5], %rd13;

    // stats.hops++
    ld.global.u64 %rd14, [statsptr+24];
    add.u64 %rd14, %rd14, 1;
    st.global.u64 [statsptr+24], %rd14;
    // stats.tests++
    ld.global.u64 %rd15, [statsptr+32];
    add.u64 %rd15, %rd15, 1;
    st.global.u64 [statsptr+32], %rd15;

    shl.b64 %rd16, %rd8, 3;
    add.u64 %rd17, qptr, %rd16;
    ld.global.u64 %rd18, [%rd17];
    rem.u64 %rd19, %rd13, %rd18;
    setp.ne.u64 %p7, %rd19, 0;
    @%p7 bra OM_return_level;
    st.global.u64 [%rd7], 0;
    bra OM_loop;

OM_return_level:
    mov.u64 %rd1, %rd11;
    sub.u64 %rd0, %rd0, 1;
    bra OM_loop;

OM_descend:
    st.global.u64 [%rd7], 1;
    // child index = depth. Ensure depth < maxcount.
    setp.ge.u64 %p8, %rd0, maxcount;
    @%p8 bra OM_fail;
    shl.b64 %rd20, %rd0, 3;
    add.u64 %rd21, flvl, %rd20;
    add.u64 %rd22, fcur, %rd20;
    add.u64 %rd23, ftotal, %rd20;
    add.u64 %rd24, fwait, %rd20;
    sub.u64 %rd25, %rd8, 1;
    st.global.u64 [%rd21], %rd25;
    ld.global.u64 %rd26, [%rd5];
    st.global.u64 [%rd22], %rd26;
    st.global.u64 [%rd23], 0;
    st.global.u64 [%rd24], 0;
    add.u64 %rd0, %rd0, 1;
    bra OM_loop;

OM_base:
    // q0 is not special-cased as parity.  Apply the same survivor rule to
    // the first implicit dimension: advance one integer, test q0, repeat only
    // if that state is actually hit.
    ld.global.u64 %rd27, [%rd5];
    mov.u64 %rd28, 0;
    ld.global.u64 %rd30, [qptr];
OM_base_loop:
    add.u64 %rd29, %rd27, 1;
    setp.lt.u64 %p9, %rd29, %rd27;
    @%p9 bra OM_fail;
    mov.u64 %rd27, %rd29;
    add.u64 %rd28, %rd28, 1;
    ld.global.u64 %rd31, [statsptr+32];add.u64 %rd31,%rd31,1;st.global.u64 [statsptr+32],%rd31;
    rem.u64 %rd31, %rd27, %rd30;
    setp.ne.u64 %p10, %rd31, 0;
    @%p10 bra OM_base_done;
    ld.global.u64 %rd31, [statsptr+24];add.u64 %rd31,%rd31,1;st.global.u64 [statsptr+24],%rd31;
    bra OM_base_loop;
OM_base_done:
    mov.u64 %rd1, %rd28;
    sub.u64 %rd0, %rd0, 1;
    bra OM_loop;

OM_done:
    st.global.u64 [outptr], %rd1;
    mov.u32 rv, 1;
    ret;
OM_fail:
    mov.u32 rv, 0;
    ret;
}

.func (.reg .u32 rv) gap_existing(
    .reg .u64 pval, .reg .u64 qptr, .reg .u64 count,
    .reg .u64 flvl, .reg .u64 fcur, .reg .u64 ftotal, .reg .u64 fwait,
    .reg .u64 maxcount, .reg .u64 outptr, .reg .u64 tmpptr, .reg .u64 statsptr)
{
    .reg .pred %p<16>;
    .reg .u32 %r<8>;
    .reg .u64 %rd<32>;

    // Obtain the first q0-survivor through the same recurrence. No odd-only shortcut.
    mov.u64 %rd0, 0;
    call.uni (%r1), own_M, (qptr, count, flvl, fcur, ftotal, fwait, %rd0, pval, maxcount, tmpptr, statsptr);
    setp.eq.u32 %p7, %r1, 0;
    @%p7 bra GE_fail;
    ld.global.u64 %rd1, [tmpptr];
    add.u64 %rd2, pval, %rd1; // candidate
    setp.lt.u64 %p0, %rd2, pval;
    @%p0 bra GE_fail;
    div.u64 %rd3, %rd2, 2;
    setp.gt.u64 %p1, 2, %rd3;
    @%p1 bra GE_quick;
    mov.u64 %rd4, 1; // i

GE_outer:
    setp.ge.u64 %p2, %rd4, count;
    @%p2 bra GE_fail;
    // layers++
    ld.global.u64 %rd5, [statsptr+0];
    add.u64 %rd5, %rd5, 1;
    st.global.u64 [statsptr+0], %rd5;
    shl.b64 %rd6, %rd4, 3;
    add.u64 %rd7, qptr, %rd6;
    ld.global.u64 %rd8, [%rd7]; // q

GE_hitloop:
    ld.global.u64 %rd9, [statsptr+32];
    add.u64 %rd9, %rd9, 1;
    st.global.u64 [statsptr+32], %rd9;
    rem.u64 %rd10, %rd2, %rd8;
    setp.ne.u64 %p3, %rd10, 0;
    @%p3 bra GE_after_hit;
    sub.u64 %rd11, %rd4, 1;
    call.uni (%r0), own_M, (qptr, count, flvl, fcur, ftotal, fwait, %rd11, %rd2, maxcount, tmpptr, statsptr);
    setp.eq.u32 %p4, %r0, 0;
    @%p4 bra GE_fail;
    ld.global.u64 %rd12, [tmpptr];
    add.u64 %rd13, %rd2, %rd12;
    setp.lt.u64 %p5, %rd13, %rd2;
    @%p5 bra GE_fail;
    mov.u64 %rd2, %rd13;
    ld.global.u64 %rd14, [statsptr+24];
    add.u64 %rd14, %rd14, 1;
    st.global.u64 [statsptr+24], %rd14;
    bra GE_hitloop;

GE_after_hit:
    div.u64 %rd15, %rd2, %rd8;
    setp.gt.u64 %p6, %rd8, %rd15;
    @%p6 bra GE_success;
    add.u64 %rd4, %rd4, 1;
    bra GE_outer;

GE_success:
    sub.u64 %rd16, %rd2, pval;
    st.global.u64 [outptr], %rd16;
    mov.u32 rv, 1;
    ret;
GE_quick:
    st.global.u64 [outptr], %rd1;
    mov.u32 rv, 1;
    ret;
GE_fail:
    mov.u32 rv, 0;
    ret;
}

.func (.reg .u32 rv) ensure_dimension(
    .reg .u64 index, .reg .u64 qptr, .reg .u64 countptr,
    .reg .u64 flvl, .reg .u64 fcur, .reg .u64 ftotal, .reg .u64 fwait,
    .reg .u64 maxcount, .reg .u64 gaptemp, .reg .u64 mtemp, .reg .u64 statsptr)
{
    .reg .pred %p<12>;
    .reg .u32 %r<8>;
    .reg .u64 %rd<24>;
ED_loop:
    ld.global.u64 %rd0, [countptr];
    setp.gt.u64 %p0, %rd0, index;
    @%p0 bra ED_done;
    setp.ge.u64 %p1, %rd0, maxcount;
    @%p1 bra ED_fail;
    sub.u64 %rd1, %rd0, 1;
    shl.b64 %rd2, %rd1, 3;
    add.u64 %rd3, qptr, %rd2;
    ld.global.u64 %rd4, [%rd3]; // last
    call.uni (%r0), gap_existing, (%rd4, qptr, %rd0, flvl, fcur, ftotal, fwait, maxcount, gaptemp, mtemp, statsptr);
    setp.eq.u32 %p2, %r0, 0;
    @%p2 bra ED_fail;
    ld.global.u64 %rd5, [gaptemp];
    add.u64 %rd6, %rd4, %rd5;
    setp.lt.u64 %p3, %rd6, %rd4;
    @%p3 bra ED_fail;
    shl.b64 %rd7, %rd0, 3;
    add.u64 %rd8, qptr, %rd7;
    st.global.u64 [%rd8], %rd6;
    add.u64 %rd0, %rd0, 1;
    st.global.u64 [countptr], %rd0;
    ld.global.u64 %rd9, [statsptr+16];
    add.u64 %rd9, %rd9, 1;
    st.global.u64 [statsptr+16], %rd9;
    ld.global.u64 %rd10, [statsptr+8];
    setp.gt.u64 %p4, %rd0, %rd10;
    @!%p4 bra ED_loop;
    st.global.u64 [statsptr+8], %rd0;
    bra ED_loop;
ED_done:
    mov.u32 rv, 1;
    ret;
ED_fail:
    mov.u32 rv, 0;
    ret;
}


// Cooperative high-dimensional next-gap evaluator.
// A single 256-thread CTA is persistent for one successor step.  Prime dimensions
// are projected in parallel in tiles of blockDim.x; atomicMin selects the first
// active dimension.  Only the nested M jump for that selected dimension is causal.
.func (.reg .u32 rv) hd_next_gap_block(
    .reg .u64 pval, .reg .u64 qptr, .reg .u64 countptr,
    .reg .u64 flvl, .reg .u64 fcur, .reg .u64 ftotal, .reg .u64 fwait,
    .reg .u64 maxcount, .reg .u64 gaptemp, .reg .u64 mtemp,
    .reg .u64 candidateptr, .reg .u64 hitptr, .reg .u64 outgap, .reg .u64 statsptr)
{
    .reg .pred %p<24>;
    .reg .u32 %r<16>;
    .reg .u64 %rd<48>;

    mov.u32 %r0, %tid.x;
    mov.u32 %r1, %ntid.x;
    setp.lt.u64 %p0, pval, 2;
    @%p0 bra HD_uniform_fail;

    // Thread 0 obtains the first q0-survivor through the same recurrence.
    // q0=2 is a normal implicit dimension, not an odd-only fast path.
    setp.ne.u32 %p1, %r0, 0;
    @%p1 bra HD_init_wait;
    ld.global.u64 %rd0, [countptr];
    mov.u64 %rd1, 0;
    call.uni (%r2), own_M, (qptr, %rd0, flvl, fcur, ftotal, fwait, %rd1, pval, maxcount, mtemp, statsptr);
    setp.eq.u32 %p2, %r2, 0;
    @%p2 bra HD_init_fail;
    ld.global.u64 %rd1, [mtemp];
    add.u64 %rd2, pval, %rd1;
    setp.lt.u64 %p2, %rd2, pval;
    @%p2 bra HD_init_fail;
    st.global.u64 [candidateptr], %rd2;
    st.global.u64 [outgap], 0;
    st.global.u32 [hitptr], 0;
    bra HD_init_wait;
HD_init_fail:
    mov.u32 %r2, 0xfffffffd;
    st.global.u32 [hitptr], %r2;
HD_init_wait:
    bar.sync 0;
    ld.global.u32 %r3, [hitptr];
    setp.eq.u32 %p3, %r3, 0xfffffffd;
    @%p3 bra HD_uniform_fail;

HD_round:
    // Thread 0 grows the internally generated dimension chain only as far as
    // exact certification requires: last_q^2 > candidate.
    setp.ne.u32 %p4, %r0, 0;
    @%p4 bra HD_ensure_wait;
HD_ensure_loop:
    ld.global.u64 %rd3, [candidateptr];
    ld.global.u64 %rd4, [countptr];
    setp.eq.u64 %p5, %rd4, 0;
    @%p5 bra HD_ensure_fail;
    sub.u64 %rd5, %rd4, 1;
    shl.b64 %rd6, %rd5, 3;
    add.u64 %rd7, qptr, %rd6;
    ld.global.u64 %rd8, [%rd7];
    div.u64 %rd9, %rd3, %rd8;
    setp.gt.u64 %p6, %rd8, %rd9;
    @%p6 bra HD_ensure_ready;
    // index=count appends exactly one new self-generated dimension.
    call.uni (%r4), ensure_dimension, (%rd4, qptr, countptr,
        flvl, fcur, ftotal, fwait, maxcount, gaptemp, mtemp, statsptr);
    setp.eq.u32 %p7, %r4, 0;
    @%p7 bra HD_ensure_fail;
    bra HD_ensure_loop;
HD_ensure_ready:
    ld.global.u64 %rd10, [countptr];
    st.global.u64 [statsptr+8], %rd10;
    bra HD_ensure_wait;
HD_ensure_fail:
    mov.u32 %r5, 0xfffffffd;
    st.global.u32 [hitptr], %r5;
HD_ensure_wait:
    bar.sync 0;
    ld.global.u32 %r6, [hitptr];
    setp.eq.u32 %p8, %r6, 0xfffffffd;
    @%p8 bra HD_uniform_fail;

    // New projection round.  Each CUDA lane owns a strided subset of q-dimensions.
    setp.ne.u32 %p9, %r0, 0;
    @%p9 bra HD_hit_init_wait;
    mov.u32 %r7, 0xffffffff;
    st.global.u32 [hitptr], %r7;
    ld.global.u64 %rd11, [statsptr+0];
    add.u64 %rd11, %rd11, 1;
    st.global.u64 [statsptr+0], %rd11;
HD_hit_init_wait:
    bar.sync 0;

    ld.global.u64 %rd12, [candidateptr];
    ld.global.u64 %rd13, [countptr];
    cvt.u64.u32 %rd14, %r0;
    add.u64 %rd14, %rd14, 1;       // q[0]=2 is already satisfied
    cvt.u64.u32 %rd15, %r1;        // lane stride
    mov.u64 %rd16, 0;              // local divisibility-test count
HD_scan_loop:
    setp.ge.u64 %p10, %rd14, %rd13;
    @%p10 bra HD_scan_done;
    shl.b64 %rd17, %rd14, 3;
    add.u64 %rd18, qptr, %rd17;
    ld.global.u64 %rd19, [%rd18];
    div.u64 %rd20, %rd12, %rd19;
    // q > candidate/q means q^2 > candidate. q is ascending, so this lane is done.
    setp.gt.u64 %p11, %rd19, %rd20;
    @%p11 bra HD_scan_done;
    add.u64 %rd16, %rd16, 1;
    rem.u64 %rd21, %rd12, %rd19;
    setp.ne.u64 %p12, %rd21, 0;
    @%p12 bra HD_scan_next;
    cvt.u32.u64 %r8, %rd14;
    atom.global.min.u32 %r9, [hitptr], %r8;
HD_scan_next:
    add.u64 %rd14, %rd14, %rd15;
    bra HD_scan_loop;
HD_scan_done:
    setp.eq.u64 %p13, %rd16, 0;
    @%p13 bra HD_scan_count_done;
    add.u64 %rd22, statsptr, 32;
    atom.global.add.u64 %rd23, [%rd22], %rd16;
HD_scan_count_done:
    bar.sync 0;

    // Thread 0 resolves the projection. No active dimension means the current
    // survivor is exact. Otherwise jump only through the selected lower-level
    // survivor map and project all dimensions again.
    setp.ne.u32 %p14, %r0, 0;
    @%p14 bra HD_resolve_wait;
    ld.global.u32 %r10, [hitptr];
    setp.eq.u32 %p15, %r10, 0xffffffff;
    @%p15 bra HD_success;
    cvt.u64.u32 %rd24, %r10;
    setp.eq.u64 %p16, %rd24, 0;
    @%p16 bra HD_resolve_fail;
    sub.u64 %rd25, %rd24, 1;
    ld.global.u64 %rd26, [candidateptr];
    ld.global.u64 %rd27, [countptr];
    call.uni (%r11), own_M, (qptr, %rd27, flvl, fcur, ftotal, fwait,
        %rd25, %rd26, maxcount, mtemp, statsptr);
    setp.eq.u32 %p17, %r11, 0;
    @%p17 bra HD_resolve_fail;
    ld.global.u64 %rd28, [mtemp];
    add.u64 %rd29, %rd26, %rd28;
    setp.lt.u64 %p18, %rd29, %rd26;
    @%p18 bra HD_resolve_fail;
    st.global.u64 [candidateptr], %rd29;
    ld.global.u64 %rd30, [statsptr+24];
    add.u64 %rd30, %rd30, 1;
    st.global.u64 [statsptr+24], %rd30;
    bra HD_resolve_wait;
HD_success:
    ld.global.u64 %rd31, [candidateptr];
    sub.u64 %rd32, %rd31, pval;
    st.global.u64 [outgap], %rd32;
    mov.u32 %r12, 0xfffffffe;
    st.global.u32 [hitptr], %r12;
    bra HD_resolve_wait;
HD_resolve_fail:
    mov.u32 %r13, 0xfffffffd;
    st.global.u32 [hitptr], %r13;
HD_resolve_wait:
    bar.sync 0;
    ld.global.u32 %r14, [hitptr];
    setp.eq.u32 %p19, %r14, 0xfffffffe;
    @%p19 bra HD_uniform_success;
    setp.eq.u32 %p20, %r14, 0xfffffffd;
    @%p20 bra HD_uniform_fail;
    bra HD_round;

HD_uniform_success:
    mov.u32 rv, 1;
    ret;
HD_uniform_fail:
    mov.u32 rv, 0;
    ret;
}

// Normal solve / self-bootstrap entry. Exactly one CTA is used; all 256 lanes
// participate in each prime-dimension projection.  The prime-to-prime chain is
// causal, but each successor step is high-dimensional across q.
.visible .entry zero_candidate_prime_hd(
    .param .u32 mode_p,
    .param .u64 value_p,
    .param .u64 qptr_p,
    .param .u64 countptr_p,
    .param .u64 flvl_p,
    .param .u64 fcur_p,
    .param .u64 ftotal_p,
    .param .u64 fwait_p,
    .param .u64 maxcount_p,
    .param .u64 out_p,
    .param .u64 statsptr_p,
    .param .u64 gaptemp_p,
    .param .u64 mtemp_p,
    .param .u64 candidate_p,
    .param .u64 hit_p)
{
    .reg .pred %p<16>;
    .reg .u32 %r<8>;
    .reg .u64 %rd<32>;

    ld.param.u32 %r0, [mode_p];
    ld.param.u64 %rd0, [value_p];
    ld.param.u64 %rd1, [qptr_p];
    ld.param.u64 %rd2, [countptr_p];
    ld.param.u64 %rd3, [flvl_p];
    ld.param.u64 %rd4, [fcur_p];
    ld.param.u64 %rd5, [ftotal_p];
    ld.param.u64 %rd6, [fwait_p];
    ld.param.u64 %rd7, [maxcount_p];
    ld.param.u64 %rd8, [out_p];
    ld.param.u64 %rd9, [statsptr_p];
    ld.param.u64 %rd10, [gaptemp_p];
    ld.param.u64 %rd11, [mtemp_p];
    ld.param.u64 %rd12, [candidate_p];
    ld.param.u64 %rd13, [hit_p];
    mov.u32 %r1, %tid.x;

    // Reset the internal dimension state. No external prime table participates.
    setp.ne.u32 %p0, %r1, 0;
    @%p0 bra ZC_reset_wait;
    st.global.u64 [%rd1], 2;
    st.global.u64 [%rd2], 1;
    st.global.u64 [%rd8+0], 0;
    st.global.u64 [%rd8+8], 0;
    st.global.u64 [%rd8+16], 0;
    st.global.u64 [%rd8+24], 0;
    st.global.u64 [%rd9+0], 0;
    st.global.u64 [%rd9+8], 1;
    st.global.u64 [%rd9+16], 0;
    st.global.u64 [%rd9+24], 0;
    st.global.u64 [%rd9+32], 0;
ZC_reset_wait:
    bar.sync 0;

    setp.eq.u32 %p1, %r0, 1;
    @%p1 bra ZC_self;
    setp.eq.u32 %p2, %r0, 2;
    @%p2 bra ZC_self;
    setp.lt.u64 %p3, %rd0, 2;
    @%p3 bra ZC_bad;
    mov.u64 %rd14, %rd0;
    bra ZC_target;

ZC_self:
    setp.lt.u64 %p4, %rd0, 1;
    @%p4 bra ZC_bad;
    mov.u64 %rd14, 2;
    mov.u64 %rd15, 1;
ZC_self_loop:
    setp.ge.u64 %p5, %rd15, %rd0;
    @%p5 bra ZC_self_done;
    // Fully implicit Self Bootstrap contract: no prime-dimension basis survives
    // from one successor to the next. Re-enter each step from q0=2 and grow
    // only the live dimensions demanded by hd_next_gap_block.
    setp.ne.u32 %p15, %r1, 0;
    @%p15 bra ZC_self_reset_wait;
    st.global.u64 [%rd1], 2;
    st.global.u64 [%rd2], 1;
ZC_self_reset_wait:
    bar.sync 0;
    add.u64 %rd16, %rd8, 16;
    call.uni (%r2), hd_next_gap_block, (%rd14, %rd1, %rd2, %rd3, %rd4, %rd5, %rd6,
        %rd7, %rd10, %rd11, %rd12, %rd13, %rd16, %rd9);
    setp.eq.u32 %p6, %r2, 0;
    @%p6 bra ZC_fail;
    ld.global.u64 %rd14, [%rd12];
    add.u64 %rd15, %rd15, 1;
    setp.eq.u64 %p7, %rd15, 0;
    @%p7 bra ZC_fail;
    bra ZC_self_loop;
ZC_self_done:
    setp.eq.u32 %p8, %r0, 2;
    @%p8 bra ZC_return_self;
    // For mode 1, target-gap statistics start here while preserving generated q.
    setp.ne.u32 %p9, %r1, 0;
    @%p9 bra ZC_stats_wait;
    st.global.u64 [%rd9+0], 0;
    ld.global.u64 %rd17, [%rd2];
