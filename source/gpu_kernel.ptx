    setp.ne.u32 %p10,%r0,0;@%p10 bra RIR_HIT_RESET_WAIT;
    mov.u32 %r4,0xffffffff;st.global.u32 [%rd23],%r4;
    ld.global.u64 %rd31,[%rd18+0];add.u64 %rd31,%rd31,1;st.global.u64 [%rd18+0],%rd31;
RIR_HIT_RESET_WAIT:
    bar.sync 0;
    ld.global.u64 %rd32,[%rd24];cvt.u64.u32 %rd33,%r0;add.u64 %rd34,%rd32,%rd33;
    setp.ge.u64 %p11,%rd34,%rd5;@%p11 bra RIR_SCAN_DONE;
    shl.b64 %rd35,%rd34,3;add.u64 %rd36,%rd6,%rd35;ld.global.u64 %rd37,[%rd36];
    ld.global.u64 %rd38,[%rd21];ld.global.u64 %rd39,[%rd22];
    call.uni (%rd40), ir_u128_mod, (%rd39,%rd38,%rd37);
    add.u64 %rd41,%rd18,32;atom.global.add.u64 %rd42,[%rd41],1;
    setp.ne.u64 %p12,%rd40,0;@%p12 bra RIR_SCAN_DONE;
    cvt.u32.u64 %r5,%rd34;atom.global.min.u32 %r6,[%rd23],%r5;
RIR_SCAN_DONE:
    bar.sync 0;
    setp.ne.u32 %p13,%r0,0;@%p13 bra RIR_RESOLVE_WAIT;
    ld.global.u32 %r7,[%rd23];setp.eq.u32 %p14,%r7,0xffffffff;@%p14 bra RIR_STEP_DONE;
    cvt.u64.u32 %rd43,%r7;setp.eq.u64 %p15,%rd43,0;@%p15 bra RIR_RESOLVE_FAIL;
    sub.u64 %rd44,%rd43,1;ld.global.u64 %rd45,[%rd21];ld.global.u64 %rd46,[%rd22];ld.global.u64 %rd47,[%rd7];
    call.uni (%r8), ir_M128, (%rd6,%rd47,%rd12,%rd13,%rd14,%rd15,%rd16,%rd44,%rd45,%rd46,%rd5,%rd20,%rd18);
    setp.eq.u32 %p16,%r8,0;@%p16 bra RIR_RESOLVE_FAIL;
    ld.global.u64 %rd48,[%rd20];add.cc.u64 %rd49,%rd45,%rd48;addc.u64 %rd50,%rd46,0;
    setp.lt.u64 %p17,%rd50,%rd46;@%p17 bra RIR_RESOLVE_FAIL;
    st.global.u64 [%rd21],%rd49;st.global.u64 [%rd22],%rd50;st.global.u64 [%rd24],%rd43;
    ld.global.u64 %rd51,[%rd18+24];add.u64 %rd51,%rd51,1;st.global.u64 [%rd18+24],%rd51;
    bra RIR_RESOLVE_WAIT;
RIR_RESOLVE_FAIL:
    mov.u32 %r9,0xfffffffd;st.global.u32 [%rd23],%r9;
    bra RIR_RESOLVE_WAIT;
RIR_STEP_DONE:
    // gap must fit u64 in the current experimental contract.
    ld.global.u64 %rd52,[%rd21];ld.global.u64 %rd53,[%rd22];
    sub.cc.u64 %rd54,%rd52,%rd2;subc.u64 %rd55,%rd53,%rd3;
    setp.ne.u64 %p18,%rd55,0;@%p18 bra RIR_RESOLVE_FAIL;
    st.global.u64 [%rd17+40],%rd54;
    mov.u32 %r10,0xfffffffe;st.global.u32 [%rd23],%r10;
RIR_RESOLVE_WAIT:
    bar.sync 0;
    ld.global.u32 %r11,[%rd23];setp.eq.u32 %p19,%r11,0xfffffffd;@%p19 bra RIR_LIMIT;
    setp.eq.u32 %p20,%r11,0xfffffffe;@%p20 bra RIR_COMMIT;
    bra RIR_PROJECT;

RIR_COMMIT:
    setp.ne.u32 %p21,%r0,0;@%p21 bra RIR_COMMIT_WAIT;
    ld.global.u64 %rd56,[%rd21];ld.global.u64 %rd57,[%rd22];mov.u64 %rd2,%rd56;mov.u64 %rd3,%rd57;
    add.cc.u64 %rd0,%rd0,1;addc.u64 %rd1,%rd1,0;
RIR_COMMIT_WAIT:
    bar.sync 0;
    // Advance the batch loop counter on every lane so CTA control flow remains
    // uniform. Only thread 0 owns the causal p/rank registers.
    add.u64 %rd25,%rd25,1;
    setp.ne.u32 %p25,%r0,0;@%p25 bra RIR_COMMIT_COUNT_WAIT;
    st.global.u64 [%rd17+48],%rd25;
RIR_COMMIT_COUNT_WAIT:
    bar.sync 0;
    bra RIR_STEP_LOOP;

RIR_SUCCESS:
    setp.ne.u32 %p22,%r0,0;@%p22 ret;
    st.global.u64 [%rd17+0],1;st.global.u64 [%rd17+8],%rd0;st.global.u64 [%rd17+16],%rd1;
    st.global.u64 [%rd17+24],%rd2;st.global.u64 [%rd17+32],%rd3;st.global.u64 [%rd17+48],%rd25;
