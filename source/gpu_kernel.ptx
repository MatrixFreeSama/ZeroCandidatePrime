    st.global.u64 [%rd8+8], %rd14;
    st.global.u64 [%rd8+16], 0;
    st.global.u64 [%rd8+24], %rd14;
    st.global.u64 [%rd8+0], 1;
    ret;

ZC_target:
    add.u64 %rd18, %rd8, 16;
    call.uni (%r3), hd_next_gap_block, (%rd14, %rd1, %rd2, %rd3, %rd4, %rd5, %rd6,
        %rd7, %rd10, %rd11, %rd12, %rd13, %rd18, %rd9);
